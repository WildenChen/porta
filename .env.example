# ── Proxy (runtime, loaded via Node --env-file) ──
PORTA_HOST=127.0.0.1       # Loopback only; set to an explicit private LAN IP for home network use
PORTA_PORT=3170
PORTA_CORS_ORIGINS=        # Comma-separated allowed origins (e.g. https://porta.example.com)

# ── Built-in application authentication ──
PORTA_AUTH_MODE=disabled   # disabled | password; used only when no runtime auth config exists
# PORTA_PASSWORD=          # Bootstrap only; prefer enabling password mode from Settings
# PORTA_DATA_DIR=          # Optional runtime config directory; defaults to ~/.porta

# ── Web development server / reverse proxy origin ──
PORTA_WEB_PORT=3070
# PORTA_ALLOWED_HOSTS=     # Exact hostnames, comma-separated; no scheme or path

# Optional outer access gate for publicly exposed Vite deployments.
# This protects the page, /api, and WebSocket before the built-in password login.
# Leave disabled for ordinary local/LAN use. When enabled, use a random token of at least 32 characters.
# PORTA_REQUIRE_AUTH=0
# PORTA_ACCESS_TOKEN=

# ── Cloudflare deployment (used by pnpm dev:cloud / pnpm deploy) ──
# PORTA_TUNNEL_NAME=       # cloudflared tunnel name (e.g. my-porta-tunnel)
# PORTA_CF_PROJECT=        # Cloudflare Pages project name (e.g. porta)
# CF_ACCESS_CLIENT_ID=
# CF_ACCESS_CLIENT_SECRET=

# ── Web (build-time, production only) ──
# VITE_API_BASE=           # Absolute API URL (e.g. https://api.example.com)
#                          # Leave unset for local dev — Vite's proxy handles /api/* routing
