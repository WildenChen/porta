{
  "name": "porta",
  "description": "Antigravity Agent MCP Bridge & Remote Access",
  "version": "0.16.0+wilden.01",
  "private": true,
  "scripts": {
    "mcp:stdio": "pnpm --filter @porta/mcp start:stdio",
    "mcp:http": "pnpm --filter @porta/mcp start:http",
    "dev": "node scripts/dev.mjs",
    "dev:cloud": "node scripts/dev-cloud.mjs",
    "dev:tailscale": "node scripts/dev-tailscale.mjs",
    "build": "pnpm -r build",
    "build:web": "pnpm --filter @porta/web build",
    "deploy": "node scripts/deploy.mjs",
    "lint": "pnpm -r lint",
    "test": "pnpm -r test",
    "test:e2e": "pnpm --filter @porta/web test:e2e"
  }
}
